{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.kiba.tools/:path*" },
    { "source": "/backend/:path*", "destination": "https://data.kiba.tools/:path*" },
    { "source": "/((?!assets|.*\\.).*)", "destination": "/index.html" }
  ]
}
