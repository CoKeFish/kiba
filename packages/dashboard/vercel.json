{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://kiba-api.suchima.com/:path*" },
    { "source": "/backend/:path*", "destination": "https://kiba-data.suchima.com/:path*" },
    { "source": "/((?!assets|.*\\.).*)", "destination": "/index.html" }
  ]
}
