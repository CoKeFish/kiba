# Imagen de PRODUCCIÓN para Coolify (VPS): build estático de Vite servido por nginx,
# que además reescribe /api → gateway y /backend → backend por la red interna del
# compose (lo que antes hacían los rewrites de vercel.json). Sin Doppler: no hay secretos.
#
# slim (glibc), no alpine (musl): la dep nativa transitiva `usb` (stellar-wallets-kit →
# trezor) trae prebuilds solo para glibc; en musl exige toolchain completa para compilar.
FROM node:20-slim AS build

WORKDIR /app

COPY packages/dashboard/package.json ./
RUN npm install

COPY packages/dashboard/ ./

# Vite hornea VITE_* en build time: llegan como build args desde el compose.
ARG VITE_WS_URL
ENV VITE_WS_URL=$VITE_WS_URL

RUN npm run build

FROM nginx:1.28-alpine

COPY packages/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
