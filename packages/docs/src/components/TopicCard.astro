---
// Tarjeta de portada al estilo "Topic → Link" de docs.trustlesswork.com:
// icono (de Starlight) o mascota (imagen bajo public/), título, descripción y
// etiqueta del enlace. Toda la tarjeta es clicable.
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';

interface Props {
  title: string;
  description: string;
  href: string;
  linkText?: string;
  icon?: StarlightIcon;
  image?: string;
  imageAlt?: string;
}

const { title, description, href, linkText = 'Read more', icon, image, imageAlt = '' } = Astro.props;
---

<article class="kb-card not-content">
  {image && <img class="kb-card__mascot" src={image} alt={imageAlt} loading="lazy" decoding="async" />}
  {icon && !image && (
    <span class="kb-card__icon" aria-hidden="true">
      <Icon name={icon} size="1.2rem" />
    </span>
  )}
  <h3 class="kb-card__title"><a href={href}>{title}</a></h3>
  <p class="kb-card__desc">{description}</p>
  <span class="kb-card__link">{linkText} <span aria-hidden="true">→</span></span>
</article>

<style>
  .kb-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.25rem 1.1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 1rem;
    background: var(--kb-card-bg);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .kb-card:hover {
    transform: translateY(-2px);
    border-color: var(--sl-color-accent);
    box-shadow: var(--kb-glow);
  }
  .kb-card__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.65rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
    margin-bottom: 0.25rem;
  }
  .kb-card__mascot {
    height: 4.75rem;
    width: auto;
    object-fit: contain;
    align-self: flex-start;
    margin-bottom: 0.25rem;
  }
  .kb-card__title {
    margin: 0;
    font-family: var(--kb-font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .kb-card__title a {
    color: var(--sl-color-white);
    text-decoration: none;
  }
  /* Toda la tarjeta es el área clicable */
  .kb-card__title a::before {
    content: '';
    position: absolute;
    inset: 0;
  }
  .kb-card__desc {
    flex: 1;
    margin: 0;
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  .kb-card__link {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }
</style>
