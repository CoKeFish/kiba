---
// Reemplaza el SocialIcons de Starlight: añade, delante del icono de GitHub,
// dos enlaces en formato pastilla (web y dashboard) como en el header de la landing.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const LABELS = {
  en: { website: 'Website', dashboard: 'Dashboard' },
  es: { website: 'Web', dashboard: 'Dashboard' },
  pt: { website: 'Site', dashboard: 'Dashboard' },
} as const;
const locale = (Astro.locals.starlightRoute.locale ?? 'en') as keyof typeof LABELS;
const t = LABELS[locale] ?? LABELS.en;
---

<a class="kb-nav-link" href="https://kiba.tools">{t.website}</a>
<a class="kb-nav-link kb-nav-link--primary" href="https://app.kiba.tools">{t.dashboard}</a>
<Default><slot /></Default>

<style>
  .kb-nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .kb-nav-link:hover {
    border-color: var(--sl-color-gray-3);
  }
  .kb-nav-link--primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: #fff;
    box-shadow: var(--kb-glow-sm);
  }
  .kb-nav-link--primary:hover {
    background: var(--kb-accent-hover);
    border-color: var(--kb-accent-hover);
  }
</style>
